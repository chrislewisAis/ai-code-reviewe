# OpenRouter
OPENROUTER_API_KEY=

# Auth
JWT_SECRET=supersecret

# Settings
MAX_DIFF_SIZE=500000 # 500KB
MAX_TOKENS_PER_JOB=100000
DEFAULT_MODEL=openai/gpt-4o-mini
